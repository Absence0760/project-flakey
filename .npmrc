# Don't auto-install peer dependencies in the dev workspace. The
# @flakeytesting/* packages declare their host framework (webdriverio,
# @playwright/test, cypress) as a peer that the consumer brings, and
# auto-installing those here pulled whole framework trees that no package
# builds or tests against, including webdriverio's vulnerable
# extract-zip / deepmerge-ts / fast-xml-parser chain (#121). A package that
# needs a peer to build or test lists it in devDependencies instead.
#
# pnpm 9 (tests.yml) and pnpm 10 (audit.yml, publish.yml) both read this
# file, and pnpm-lock.yaml records the setting: a frozen install fails if
# the two disagree, so change it only together with a regenerated lockfile.
auto-install-peers=false
